# Generated by Ansible from mpv.conf.j2
vo=gpu-next
hwdec=vaapi
profile=gpu-hq
fullscreen
input-ipc-server=/tmp/mpvsocket
pause
reset-on-next-file=pause
loop-playlist

# Multi-player synchronization (mpv-sync.lua)
script={{ content_dir | default('/home/' ~ ansible_user ~ '/content') }}/mpv-sync.lua

{% if inventory_hostname == groups['video_player'][0] %}
# Role: LEADER (controlling all followers)
script-opts=sync-backend=socat,sync-role=leader,sync-target={{ video_sync_broadcast | default(ansible_default_ipv4.broadcast | default('255.255.255.255')) }}:12338,sync-interval=0.5,sync-show_osd=no
{% else %}
# Role: FOLLOWER (synced to leader)
script-opts=sync-backend=socat,sync-role=follower,sync-target=127.0.0.1:12338,sync-initial_offset=0.015,sync-show_osd=no
{% endif %}
